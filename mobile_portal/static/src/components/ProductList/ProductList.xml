<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="mobile_portal.ProductList">
    <!-- Search bar -->
    <div class="sbar2">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#aaa9a2" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="8"/>
            <path d="M21 21l-4.35-4.35"/>
        </svg>
        <input class="sinput"
               type="search"
               placeholder="Tìm sản phẩm (bằng mã, tên, hoặc tên danh mục)..."
               t-att-value="props.filterQ"
               t-on-input="onSearchInput"/>
    </div>

    <!-- Category tree (multi-select, up to 3 levels) -->
    <div class="catnode" t-att-class="{'on': props.filterCat.length === 0}"
         t-on-click="() => this.onCatClick(0)">
        <span>Tất cả</span>
    </div>

    <t t-foreach="props.categories" t-as="cat" t-key="cat.id">
        <div class="catnode-wrap">
            <div class="catnode" t-att-class="{'on': props.filterCat.includes(cat.id)}"
                 t-on-click="() => this.onCatClick(cat.id)">
                <span><t t-esc="cat.name"/></span>
            </div>

            <t t-if="cat.children &amp;&amp; cat.children.length">
                <div class="catnode-children">
                    <t t-foreach="cat.children" t-as="child" t-key="child.id">
                        <div class="catnode catnode--l2" t-att-class="{'on': props.filterCat.includes(child.id)}"
                             t-on-click="() => this.onCatClick(child.id)">
                            <span><t t-esc="child.name"/></span>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>

    <!-- Product grid -->
    <div class="pgrid">
        <t t-if="props.products.length === 0">
            <div style="grid-column: 1 / -1; text-align:center; padding:40px; color:#aaa9a2; font-size:13px;">
                Không tìm thấy sản phẩm
            </div>
        </t>

        <t t-foreach="props.products" t-as="product" t-key="product.id">
            <div class="pcard" t-on-click="() => this.onCardClick(product)">
                <!-- Thumbnail: product image with letter fallback -->
                <div class="pthumb" t-att-style="'background:' + product.bg">
                    <img class="pimg"
                         t-att-src="'/web/image/product.template/' + product.id + '/image_256'"
                         t-att-alt="product.name"
                         t-on-error="(ev) => this.onImgError(ev, product)"/>
                    <span class="pletter pletter-fallback" t-att-style="'color:' + product.tc">
                        <t t-esc="product.letter"/>
                    </span>
                    <!-- "in cart" chip -->
                    <t t-if="cartQty(product.id) > 0">
                        <div class="cinchip">
                            ×<t t-esc="cartQty(product.id)"/>
                        </div>
                    </t>
                </div>
                <!-- Product info -->
                <div class="pinfo">
                    <div class="pname"><t t-esc="product.name"/></div>
                    <div class="pprow">
                        <span class="pprice"><t t-esc="product.priceFormatted"/>/</span>
                        <span class="punit"><t t-esc="product.unit"/></span>
                        <t t-if="product.tax_rate">
                            <span class="ptax">(VAT <t t-esc="Math.round(product.tax_rate)"/>%)</span>
                        </t>
                    </div>
                    <t t-if="product.code">
                        <div class="pcode">MSP: <t t-esc="product.code"/></div>
                    </t>
                </div>
            </div>
        </t>
    </div>

    <!-- Infinite scroll sentinel + loading indicator -->
    <div t-ref="sentinel" class="load-more-sentinel">
        <t t-if="props.loadingMore">
            <div class="mp-loading" style="padding:16px 20px;">
                <span class="mp-spinner"/>
                <span>Đang tải thêm...</span>
            </div>
        </t>
        <t t-elif="!props.hasMore and props.products.length > 0">
            <div class="load-more-end">Đã hiển thị tất cả sản phẩm</div>
        </t>
    </div>

    <!-- Scroll-to-top -->
    <t t-if="ui.showScrollTop">
        <button class="scroll-top-btn" t-on-click="scrollToTop" aria-label="Lên đầu trang">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="19" x2="12" y2="5"/>
                <polyline points="5 12 12 5 19 12"/>
            </svg>
        </button>
    </t>
</t>

</templates>
