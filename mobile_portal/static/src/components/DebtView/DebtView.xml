<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="mobile_portal.DebtView">

    <!-- Date-range filter — luôn hiển thị (không phụ thuộc isLoading) -->
    <div class="shd" style="padding-top:14px">Khoảng thời gian</div>
    <div class="debt-filter">
        <div class="dfrow">
            <div class="dffield">
                <label class="dflbl">Từ ngày</label>
                <input type="date" class="dfinput" t-att-value="local.dateFrom" t-on-change="onDateFromInput"/>
            </div>
            <div class="dffield">
                <label class="dflbl">Đến ngày</label>
                <input type="date" class="dfinput" t-att-value="local.dateTo" t-on-change="onDateToInput"/>
            </div>
        </div>
        <button class="dfbtn" t-on-click="applyFilter" t-att-disabled="props.isLoading">Lọc</button>
    </div>

    <t t-if="props.isLoading">
        <div class="loading-wrap">Đang tải công nợ...</div>
    </t>

    <t t-else="">
        <!-- Summary cards: 3 columns -->
        <div class="shd">Tổng quan công nợ</div>
        <div class="dsummary">
            <div class="dcrd">
                <div class="dclbl">Đã TT (kỳ đã chọn)</div>
                <div class="dcval" style="color:#27500A">
                    <t t-esc="paidAmountFmt"/>
                </div>
            </div>
            <div class="dcrd">
                <div class="dclbl">Còn thiếu (hiện tại)</div>
                <div class="dcval" style="color:#A32D2D">
                    <t t-esc="remainingAmountFmt"/>
                </div>
            </div>
            <div class="dcrd">
                <div class="dclbl">Đang giữ (hiện tại)</div>
                <div class="dcval" style="color:#F78614">
                    <t t-esc="heldAmountFmt"/>
                </div>
            </div>
        </div>
        <div t-if="periodLabel" style="padding:0 14px 8px;font-size:11px;color:#aaa9a2">
            Đã thanh toán <t t-esc="paidAmountFmt"/> trong khoảng <t t-esc="periodLabel"/>
        </div>

        <!-- Payment history (đã lọc theo khoảng thời gian ở trên) — hiện dần 6 dòng -->
        <div class="shd">Lịch sử thanh toán</div>
        <t t-if="props.debt.payments.length > 0">
            <div class="paylist">
                <t t-foreach="visiblePayments" t-as="pay" t-key="pay.id">
                    <div class="prow">
                        <div class="picon">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
                                 stroke="#F78614" stroke-width="1.8" stroke-linecap="round">
                                <rect x="2" y="5" width="20" height="14" rx="2"/>
                                <line x1="2" y1="10" x2="22" y2="10"/>
                            </svg>
                        </div>
                        <div class="pinfo2">
                            <div class="pref"><t t-esc="pay.ref"/></div>
                            <div class="pfor">
                                <t t-esc="pay.method"/><t t-if="pay.memo"> • <t t-esc="pay.memo"/></t>
                            </div>
                            <div style="font-size:11px;color:#aaa9a2;margin-top:1px">
                                <t t-esc="pay.date"/>
                            </div>
                            <t t-if="pay.held > 0">
                                <div class="pheld">Đang giữ: <t t-esc="payHeldFmt(pay)"/></div>
                            </t>
                        </div>
                        <div class="pamt"><t t-esc="payAmtFmt(pay)"/></div>
                    </div>
                </t>
            </div>
            <!-- Nút "Xem thêm" cho lịch sử thanh toán (bấm mới load, không tự cuộn) -->
            <t t-if="hasMorePayments">
                <div style="padding:10px 14px 4px;text-align:center">
                    <button class="loadmore-btn" t-on-click="loadMorePayments">Xem thêm</button>
                </div>
            </t>
        </t>
        <t t-else="">
            <div style="text-align:center;padding:24px 20px;color:#aaa9a2;font-size:12px">
                Không có khoản thanh toán nào trong khoảng thời gian này
            </div>
        </t>

        <!-- Per-order debt breakdown — hiện dần 6 dòng, load thêm khi cuộn tới cuối -->
        <div class="shd">Chi tiết theo đơn hàng</div>
        <div class="dolist">
            <t t-foreach="visibleOrders" t-as="order" t-key="order.id">
                <div class="dorow" t-on-click="() => this.props.onOpenDetail(order)">
                    <div class="dortop">
                        <div>
                            <div class="doref2"><t t-esc="order.ref"/></div>
                            <div style="font-size:11px;color:#aaa9a2">
                                <t t-esc="order.date"/>
                            </div>
                        </div>
                        <span class="psbadge" t-att-class="orderPayInfo(order).cls">
                            <t t-esc="orderPayInfo(order).label"/>
                        </span>
                    </div>

                    <!-- Progress + amounts for non-cancelled orders -->
                    <t t-if="order.status !== 'cancel'">
                        <div class="barwrap">
                            <div class="barfill"
                                 t-att-style="'width:' + orderBarPct(order) + '%;background:' + orderPayInfo(order).color"/>
                        </div>
                        <div class="barlbls">
                            <span style="color:#27500A;font-weight:500">
                                <t t-esc="orderPaidFmt(order)"/> đã TT
                            </span>
                            <span style="color:#F78614;font-weight:500">
                                <t t-esc="orderTotalFmt(order)"/>
                            </span>
                        </div>
                        <t t-if="order.total > order.paid">
                            <div style="font-size:11px;color:#A32D2D;text-align:right;margin-top:4px">
                                Còn: <t t-esc="orderRemainFmt(order)"/>
                            </div>
                        </t>
                    </t>
                    <t t-else="">
                        <div style="font-size:11px;color:#aaa9a2;margin-top:2px">Đơn hàng đã hủy</div>
                    </t>
                </div>
            </t>
        </div>

        <!-- Nút "Xem thêm" cho chi tiết đơn hàng (bấm mới load, không tự cuộn) -->
        <t t-if="hasMoreOrders">
            <div style="padding:10px 14px 4px;text-align:center">
                <button class="loadmore-btn" t-on-click="loadMoreOrders">Xem thêm</button>
            </div>
        </t>

        <div style="height:32px"/>
    </t>

</t>

</templates>
