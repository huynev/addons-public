<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="pos_login_template" name="POS Direct Login Page">
    <t t-call="web.layout">
      <t t-set="head">
        <title>POS - Đăng nhập</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <link rel="stylesheet" t-att-href="'/pos_direct_login/static/src/css/pos_login.css'"/>
      </t>
      <t t-set="body_classname">pos-login-body</t>

      <canvas id="pos-particles" style="position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0;"/>
      <div class="floating-shape shape-1"/>
      <div class="floating-shape shape-2"/>
      <div class="floating-shape shape-3"/>

      <div class="pos-login-wrapper">
        <div class="pos-login-card">

          <!-- Logo -->
          <div class="pos-login-logo">
            <div class="pos-login-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96C5 16.1 6.1 17 7 17h11v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63H18c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0022.46 4H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
              </svg>
            </div>
            <h1 class="pos-login-title">Point of Sale</h1>
            <p class="pos-login-subtitle">Đăng nhập để mở quầy bán hàng</p>
          </div>

          <!-- Error -->
          <t t-if="error">
            <div class="pos-login-alert">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
              <span t-esc="error"/>
            </div>
          </t>

          <!-- Tabs -->
          <div class="pos-tabs">
            <button type="button" class="pos-tab" id="tab-account"
                    t-att-class="'pos-tab' + (' active' if tab == 'account' or not tab else '')">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
              Tài khoản
            </button>
            <button type="button" class="pos-tab" id="tab-pin"
                    t-att-class="'pos-tab' + (' active' if tab == 'pin' else '')">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
              Mã PIN
            </button>
          </div>

          <!-- ══ Tab 1: Tài khoản Odoo ══ -->
          <div id="panel-account" class="tab-panel">
            <form id="form-account" method="POST" action="/pos-login/authenticate" class="pos-login-form" autocomplete="on">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

              <!-- POS config chọn trước (nếu nhiều shop) -->
              <div class="form-group" id="config-group-account" style="display:none;">
                <label class="form-label">Cửa hàng POS</label>
                <div class="form-input-wrapper">
                  <span class="form-input-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg></span>
                  <select id="pos_config_id_account" name="pos_config_id" class="form-input">
                    <option value="">-- Tự động chọn --</option>
                  </select>
                  <span class="select-arrow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg></span>
                </div>
              </div>

              <!-- Username -->
              <div class="form-group">
                <label class="form-label" for="login">Tên đăng nhập</label>
                <div class="form-input-wrapper">
                  <span class="form-input-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg></span>
                  <input id="login" name="login" type="text" class="form-input" placeholder="Email hoặc tên đăng nhập" autocomplete="username" required="required"/>
                </div>
              </div>

              <!-- Password -->
              <div class="form-group">
                <label class="form-label" for="password">Mật khẩu</label>
                <div class="form-input-wrapper">
                  <span class="form-input-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg></span>
                  <input id="password" name="password" type="password" class="form-input" placeholder="Mật khẩu" autocomplete="current-password" required="required" style="padding-right:48px;"/>
                  <button type="button" class="toggle-password" tabindex="-1">
                    <svg class="eye-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                    <svg class="eye-closed" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" style="display:none;"><path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46A11.804 11.804 0 001 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/></svg>
                  </button>
                </div>
              </div>

              <button type="submit" class="pos-login-btn">
                <span class="btn-content">
                  <span class="btn-text">Đăng nhập</span>
                  <span class="btn-spinner"/>
                </span>
              </button>
            </form>
          </div>

          <!-- ══ Tab 2: Mã PIN nhân viên ══ -->
          <div id="panel-pin" class="tab-panel" style="display:none;">
            <form id="form-pin" method="POST" action="/pos-login/authenticate-pin" class="pos-login-form">
              <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

              <!-- POS config -->
              <div class="form-group" id="config-group-pin" style="display:none;">
                <label class="form-label">Cửa hàng POS</label>
                <div class="form-input-wrapper">
                  <span class="form-input-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg></span>
                  <select id="pos_config_id_pin" name="pos_config_id" class="form-input">
                    <option value="">-- Tự động chọn --</option>
                  </select>
                  <span class="select-arrow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg></span>
                </div>
              </div>

              <!-- Chọn nhân viên -->
              <div class="form-group">
                <label class="form-label">Nhân viên</label>
                <div class="form-input-wrapper">
                  <span class="form-input-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg></span>
                  <select id="employee_id" name="employee_id" class="form-input" required="required">
                    <option value="">-- Đang tải nhân viên... --</option>
                  </select>
                  <span class="select-arrow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/></svg></span>
                </div>
              </div>

              <!-- Hiển thị PIN dots -->
              <div class="form-group">
                <label class="form-label">Mã PIN</label>
                <input type="hidden" id="pin-value" name="pin"/>
                <div class="pin-dots" id="pin-dots">
                  <span class="pin-dot" id="dot-0"/>
                  <span class="pin-dot" id="dot-1"/>
                  <span class="pin-dot" id="dot-2"/>
                  <span class="pin-dot" id="dot-3"/>
                  <span class="pin-dot" id="dot-4"/>
                  <span class="pin-dot" id="dot-5"/>
                </div>
              </div>

              <!-- Numpad -->
              <div class="numpad">
                <button type="button" class="numpad-key" data-val="1">1</button>
                <button type="button" class="numpad-key" data-val="2">2</button>
                <button type="button" class="numpad-key" data-val="3">3</button>
                <button type="button" class="numpad-key" data-val="4">4</button>
                <button type="button" class="numpad-key" data-val="5">5</button>
                <button type="button" class="numpad-key" data-val="6">6</button>
                <button type="button" class="numpad-key" data-val="7">7</button>
                <button type="button" class="numpad-key" data-val="8">8</button>
                <button type="button" class="numpad-key" data-val="9">9</button>
                <button type="button" class="numpad-key numpad-clear" id="numpad-clear">Xóa</button>
                <button type="button" class="numpad-key" data-val="0">0</button>
                <button type="button" class="numpad-key numpad-del" id="numpad-del">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M22 3H7c-.69 0-1.23.35-1.59.88L0 12l5.41 8.11c.36.53.9.89 1.59.89h15c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-3 12.59L17.59 17 14 13.41 10.41 17 9 15.59 12.59 12 9 8.41 10.41 7 14 10.59 17.59 7 19 8.41 15.41 12 19 15.59z"/></svg>
                </button>
              </div>

              <button type="submit" class="pos-login-btn" id="pin-submit-btn" disabled="disabled">
                <span class="btn-content">
                  <span class="btn-text">Đăng nhập bằng PIN</span>
                  <span class="btn-spinner"/>
                </span>
              </button>
            </form>
          </div>

          <!-- Footer -->
          <div class="pos-login-footer">
            <span>Phiên làm việc được bảo mật</span>
            <span style="margin:0 8px;">·</span>
            <a href="/web/login">Vào trang quản trị</a>
          </div>

        </div>
      </div>

      <script t-att-src="'/pos_direct_login/static/src/js/pos_login.js'"/>
    </t>
  </template>
</odoo>
