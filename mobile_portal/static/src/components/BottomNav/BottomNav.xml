<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="mobile_portal.BottomNav">
    <div class="bnav">
        <!-- Products tab -->
        <div class="ntab" t-att-class="{'on': isActive('products')}"
             t-on-click="() => this.onTabClick('products')">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none"
                 t-att-stroke="isActive('products') ? '#0F6E56' : '#aaa9a2'"
                 stroke-width="1.8" stroke-linecap="round">
                <rect x="3" y="3" width="7" height="7" rx="1.5"/>
                <rect x="14" y="3" width="7" height="7" rx="1.5"/>
                <rect x="3" y="14" width="7" height="7" rx="1.5"/>
                <rect x="14" y="14" width="7" height="7" rx="1.5"/>
            </svg>
            <span class="nlbl" t-att-style="isActive('products') ? 'color:#0F6E56' : ''">Sản phẩm</span>
        </div>

        <!-- Cart tab (with badge when cart has items) -->
        <div class="ntab" t-att-class="{'on': isActive('cart')}"
             t-on-click="() => this.onTabClick('cart')">
            <div style="position:relative;display:inline-flex">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none"
                     t-att-stroke="isActive('cart') ? '#0F6E56' : '#aaa9a2'"
                     stroke-width="1.8" stroke-linecap="round">
                    <circle cx="9" cy="21" r="1"/>
                    <circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61H19a2 2 0 001.99-1.61L23 6H6"/>
                </svg>
                <!-- Badge on cart icon in nav -->
                <t t-if="props.cartCount > 0">
                    <span style="position:absolute;top:-5px;right:-7px;background:#D85A30;color:#fff;border-radius:10px;font-size:9px;font-weight:500;padding:1px 4px;line-height:14px;min-width:14px;text-align:center;">
                        <t t-esc="props.cartCount"/>
                    </span>
                </t>
            </div>
            <span class="nlbl" t-att-style="isActive('cart') ? 'color:#0F6E56' : ''">Giỏ hàng</span>
        </div>

        <!-- Orders tab -->
        <div class="ntab" t-att-class="{'on': isActive('orders')}"
             t-on-click="() => this.onTabClick('orders')">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none"
                 t-att-stroke="isActive('orders') ? '#0F6E56' : '#aaa9a2'"
                 stroke-width="1.8" stroke-linecap="round">
                <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="16" y1="13" x2="8" y2="13"/>
                <line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
            <span class="nlbl" t-att-style="isActive('orders') ? 'color:#0F6E56' : ''">Đơn hàng</span>
        </div>

        <!-- Debt tab -->
        <div class="ntab" t-att-class="{'on': isActive('debt')}"
             t-on-click="() => this.onTabClick('debt')">
            <svg width="21" height="21" viewBox="0 0 24 24" fill="none"
                 t-att-stroke="isActive('debt') ? '#0F6E56' : '#aaa9a2'"
                 stroke-width="1.8" stroke-linecap="round">
                <line x1="12" y1="1" x2="12" y2="23"/>
                <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/>
            </svg>
            <span class="nlbl" t-att-style="isActive('debt') ? 'color:#0F6E56' : ''">Công nợ</span>
        </div>
    </div>
</t>

</templates>
