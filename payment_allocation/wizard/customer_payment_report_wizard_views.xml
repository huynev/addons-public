<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customer_payment_report_wizard_form" model="ir.ui.view">
        <field name="name">customer.payment.report.wizard.form</field>
        <field name="model">customer.payment.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Báo cáo thanh toán theo khách hàng">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="partner_ids" widget="many2many_tags"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <field name="line_ids" invisible="not line_ids">
                    <tree decoration-warning="remaining_amount == 0 and held_amount &gt; 0">
                        <field name="partner_id"/>
                        <field name="paid_amount" sum="Tổng đã thanh toán"/>
                        <field name="remaining_amount" sum="Tổng còn phải thu"/>
                        <field name="held_amount" sum="Tổng chưa phân bổ"/>
                        <field name="currency_id" column_invisible="1"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_generate_report" type="object"
                            string="Xem báo cáo" class="btn-primary"/>
                    <button string="Đóng" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_customer_payment_report_wizard" model="ir.actions.act_window">
        <field name="name">Báo cáo thanh toán theo khách hàng</field>
        <field name="res_model">customer.payment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
