<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
<t t-name="mobile_portal.PortalApp">
<div class="mp-root">

    <!-- ══ AUTH SCREENS ══ -->
    <t t-if="state.view === 'login'">
        <LoginPage onLoginSuccess.bind="onLoginSuccess" onGoRegister.bind="goToRegister"/>
    </t>
    <t t-elif="state.view === 'register'">
        <RegisterPage onRegisterSuccess.bind="onRegisterSuccess" onGoLogin.bind="goToLogin"/>
    </t>

    <!-- ══ MAIN APP ══ -->
    <t t-elif="state.view === 'app'">
        <div class="mp-app">

            <!-- Header -->
            <header class="mp-header">
                <div class="mp-header-inner">
                    <div class="mp-brand">
                        <div class="mp-brand-icon">
                            <svg width="16" height="16" viewBox="0 0 30 30" fill="none">
                                <rect x="3" y="3" width="10" height="10" rx="3" fill="#fff" fill-opacity=".95"/>
                                <rect x="17" y="3" width="10" height="10" rx="3" fill="#fff" fill-opacity=".5"/>
                                <rect x="3" y="17" width="10" height="10" rx="3" fill="#fff" fill-opacity=".5"/>
                                <rect x="17" y="17" width="10" height="10" rx="3" fill="#fff" fill-opacity=".95"/>
                            </svg>
                        </div>
                        <div>
                            <div class="mp-brand-name">Đặt hàng</div>
                            <div class="mp-brand-sub"><t t-esc="state.userName"/></div>
                        </div>
                    </div>
                    <div class="mp-header-actions">
                        <button class="mp-icon-btn" t-on-click="() => this.switchTab('cart')">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                                <path d="M1 1h4l2.68 13.39a2 2 0 001.99 1.61H19a2 2 0 001.99-1.61L23 6H6"/>
                            </svg>
                            <t t-if="cartCount > 0">
                                <span class="mp-badge"><t t-esc="cartCount"/></span>
                            </t>
                        </button>
                        <button class="mp-icon-btn mp-icon-btn-ghost" t-on-click="onLogout">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
                                <polyline points="16 17 21 12 16 7"/>
                                <line x1="21" y1="12" x2="9" y2="12"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </header>

            <!-- Tab content -->
            <main class="mp-content">
                <!-- Sản phẩm -->
                <div class="mp-pane" t-att-class="{'mp-pane--active': state.currentTab === 'products'}">
                    <t t-if="state.loadingProducts">
                        <div class="mp-loading"><span class="mp-spinner"/><span>Đang tải sản phẩm...</span></div>
                    </t>
                    <t t-else="">
                        <ProductList products="filteredProducts" categories="state.categories"
                                     filterCat="state.filterCat" filterQ="state.filterQ"
                                     cart="state.cart"
                                     onOpenModal.bind="onOpenModal"
                                     onFilterCat.bind="onFilterCat"
                                     onFilterQ.bind="onFilterQ"/>
                    </t>
                </div>

                <!-- Giỏ hàng -->
                <div class="mp-pane" t-att-class="{'mp-pane--active': state.currentTab === 'cart'}">
                    <Cart items="cartItems" onUpdateQty.bind="onUpdateCartQty"
                          onPlace.bind="onPlaceOrder" isPlacing="state.isPlacing"/>
                </div>

                <!-- Đơn hàng -->
                <div class="mp-pane" t-att-class="{'mp-pane--active': state.currentTab === 'orders'}">
                    <OrderList orders="state.orders" isLoading="state.loadingOrders"
                               onOpenDetail.bind="onOpenDetail"/>
                </div>

                <!-- Công nợ -->
                <div class="mp-pane" t-att-class="{'mp-pane--active': state.currentTab === 'debt'}">
                    <DebtView orders="state.orders" payments="state.payments"
                              isLoading="state.loadingOrders" onOpenDetail.bind="onOpenDetail"/>
                </div>

                <!-- Order detail slide -->
                <OrderDetail order="state.detailOrder" onClose.bind="onCloseDetail"/>
            </main>

            <!-- Bottom nav -->
            <BottomNav currentTab="state.currentTab" cartCount="cartCount" onSwitch.bind="switchTab"/>

            <!-- Product modal -->
            <t t-if="state.showModal and state.modalProduct">
                <ProductModal product="state.modalProduct" initialQty="state.modalQty"
                              onAdd.bind="onAddToCart" onClose.bind="onCloseModal"/>
            </t>

            <!-- Toast -->
            <div class="mp-toast" t-att-class="{'mp-toast--show': state.toastVisible}">
                <t t-esc="state.toastMsg"/>
            </div>
        </div>
    </t>
</div>
</t>
</templates>
